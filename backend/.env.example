# ─── Anthropic API (the assistant) ──────────────────────────────────
# Required for live answers. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model + reasoning effort (defaults shown). Effort: low | medium | high
#ANTHROPIC_MODEL=claude-opus-5-5
#ASSISTANT_EFFORT=medium
#ASSISTANT_MAX_TOKENS=8000

# ─── Demo mode ───────────────────────────────────────────────────────
# Run the whole UI with canned answers and no API calls (no key needed).
#ASSISTANT_MOCK=true
